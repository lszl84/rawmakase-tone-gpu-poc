#version 450
// Resamples the mipmapped photo to the exact on-screen size, once per zoom or
// resize: four bilinear taps over each output pixel's footprint, from the mip
// level with about two texels per tap.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D source;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D target;

layout(push_constant) uniform Params {
    ivec2 size; // target size in pixels
    float lod;  // source mip level
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, pc.size))) {
        return;
    }
    vec2 texel = 1.0 / vec2(pc.size);
    vec2 uv = (vec2(p) + 0.5) * texel;
    vec2 q = texel * 0.25;
    vec4 sum = textureLod(source, uv + vec2(-q.x, -q.y), pc.lod)
             + textureLod(source, uv + vec2( q.x, -q.y), pc.lod)
             + textureLod(source, uv + vec2(-q.x,  q.y), pc.lod)
             + textureLod(source, uv + vec2( q.x,  q.y), pc.lod);
    imageStore(target, p, sum * 0.25);
}
